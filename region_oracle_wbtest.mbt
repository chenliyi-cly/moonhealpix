test "continuous face cap enclosure independent astropy n2" {
  let g = Grid::new(2)
  let cell = Cell::new(g, 0)
  for
    point in [
      LonLat::new(0.7853981633974483, 0.0),
      LonLat::new(1.1780972450961724, 0.3398369094541219),
      LonLat::new(0.39269908169872414, 0.3398369094541219),
