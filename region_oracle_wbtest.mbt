      LonLat::new(0.6872233929727672, 0.3363035751539803),
      LonLat::new(0.9817477042468102, 0.16744807921968932),
      LonLat::new(0.9817477042468103, 0.5235987755982989),
    ] {
    assert_true(g.nested_center(0).separation(point) <= cell.bounding_radius())
  }
  let cell = Cell::new(g, 2)
  for
    point in [
      LonLat::new(0.39269908169872414, 0.3398369094541219),
      LonLat::new(0.7853981633974483, 0.7297276562269663),
      LonLat::new(0.0, 0.7297276562269663),
      LonLat::new(0.0, 1.1596584644725487),
      LonLat::new(0.039269908169872365, 0.6971039923129358),
      LonLat::new(0.2945243112740431, 0.725264414170526),
      LonLat::new(0.5890486225480862, 0.5235987755982989),
      LonLat::new(0.5235987755982988, 0.948427838239876),
    ] {
    assert_true(g.nested_center(2).separation(point) <= cell.bounding_radius())
  }
  let cell = Cell::new(g, 3)
  for
    point in [
