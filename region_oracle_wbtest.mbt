      LonLat::new(0.7853741949476376, 8.056640633715869e-05),
      LonLat::new(0.7854461002970698, 4.0690104177894994e-05),
      LonLat::new(0.7854461002970697, 0.0001220703128031649),
    ] {
    assert_true(g.nested_center(0).separation(point) <= cell.bounding_radius())
  }
