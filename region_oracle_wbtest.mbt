///|
test "continuous face cap enclosure independent astropy n1" {
  let g = Grid::new(1)
  let cell = Cell::new(g, 0)
  for
    point in [
      LonLat::new(0.7853981633974483, 0.0),
      LonLat::new(1.5707963267948966, 0.7297276562269663),
      LonLat::new(0.0, 0.7297276562269663),
      LonLat::new(0.0, 1.5707963267948966),
      LonLat::new(0.07853981633974481, 0.6653484969274126),
      LonLat::new(0.5890486225480862, 0.7208187608700896),
      LonLat::new(1.1780972450961724, 0.3398369094541219),
      LonLat::new(1.5707963267948966, 1.1596584644725487),
    ] {
    assert_true(g.nested_center(0).separation(point) <= cell.bounding_radius())
  }
  let cell = Cell::new(g, 1)
  for
    point in [
      LonLat::new(2.356194490192345, 0.0),
      LonLat::new(3.141592653589793, 0.7297276562269663),
      LonLat::new(1.5707963267948966, 0.7297276562269663),
      LonLat::new(0.0, 1.5707963267948966),
      LonLat::new(1.6493361431346414, 0.6653484969274126),
      LonLat::new(2.1598449493429825, 0.7208187608700896),
      LonLat::new(2.748893571891069, 0.3398369094541219),
      LonLat::new(3.141592653589793, 1.1596584644725487),
    ] {
    assert_true(g.nested_center(1).separation(point) <= cell.bounding_radius())
  }
  let cell = Cell::new(g, 2)
  for
    point in [
      LonLat::new(3.926990816987241, 0.0),
