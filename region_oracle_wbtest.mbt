///|
test "continuous face cap enclosure independent astropy n16" {
  let g = Grid::new(16)
  let cell = Cell::new(g, 0)
  for
    point in [
      LonLat::new(0.7853981633974483, 0.0),
      LonLat::new(0.8344855486097889, 0.041678732422577865),
