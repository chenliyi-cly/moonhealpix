///|
test "independent disc centers and footprint inclusion n1 case0" {
  let g = Grid::new(1)
  let center = LonLat::degrees(359.9, 0.0)
  let expected : Array[Int32] = [4]
  assert_eq(
    g
    .search_disc(center, 0.13962634015954636, g.npix(), 100000)
    .pixels()
    .pixels(g.npix()),
    expected,
  )
  let cover = g
    .cover_disc(center, 0.13962634015954636, 2, g.npix(), 1000000)
    .pixels()
  for pixel in [4] {
    assert_true(cover.contains(pixel))
  }
}

