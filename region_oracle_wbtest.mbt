///|
test "independent disc centers and footprint inclusion n8 case22" {
  let g = Grid::new(8)
  let center = LonLat::degrees(0.0, -90.0)
  let expected : Array[Int32] = []
  assert_eq(
    g.search_disc(center, 0.0, g.npix(), 100000).pixels().pixels(g.npix()),
    expected,
  )
  let cover = g.cover_disc(center, 0.0, 2, g.npix(), 1000000).pixels()
  for pixel in [512, 576, 640, 704] {
    assert_true(cover.contains(pixel))
  }
}

