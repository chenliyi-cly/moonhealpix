///|
test "spherical-geometry polygon reference n8 case9" {
  let g = Grid::new(8)
  let polygon = SphericalPolygon::new(
    [
      LonLat::degrees(350.0, -10.0),
      LonLat::degrees(15.0, -10.0),
      LonLat::degrees(15.0, 12.0),
      LonLat::degrees(350.0, 12.0),
    ],
    10,
  )
  let expected : Array[Int32] = [
    269, 270, 271, 280, 282, 283, 293, 304, 305, 306,
  ]
  assert_eq(
    g.query_polygon(polygon, g.npix(), 100000).pixels(g.npix()),
    expected,
  )
}

///|
test "spherical-geometry polygon reference n8 case10" {
  let g = Grid::new(8)
  let polygon = SphericalPolygon::new(
