///|
test "continuous face cap enclosure independent astropy n8192" {
  let g = Grid::new(8192)
  let cell = Cell::new(g, 0)
  for
    point in [
      LonLat::new(0.7853981633974483, 0.0),
      LonLat::new(0.7854940371966911, 8.138020842315997e-05),
