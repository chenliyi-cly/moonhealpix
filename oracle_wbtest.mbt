    (
      570, 6.027210737530016, 0.6828536981385183, 39, 53, 6.086835766330224, 0.7297276562269663,
      6.086835766330224, 0.7297276562269663, 53, 39,
    ),
    (
      571, 0.7717227544014237, -0.22293489565554278, 106, 143, 0.7853981633974483,
      -0.16744807921968932, 0.7853981633974483, -0.16744807921968932, 143, 106,
    ),
    (
      572, 1.4244310687317134, 0.35214121042263047, 59, 94, 1.3744467859455345, 0.3398369094541219,
      1.3744467859455345, 0.3398369094541219, 94, 59,
    ),
    (
      573, 1.5560802729932186, -0.6048095001213181, 140, 80, 1.5707963267948966,
      -0.5235987755982989, 1.5707963267948966, -0.5235987755982989, 80, 140,
    ),
    (
      574, 5.048306781503154, 0.14635673618951228, 85, 119, 5.105088062083414, 0.16744807921968932,
      5.105088062083414, 0.16744807921968932, 119, 85,
    ),
    (
      575, 5.809228859403653, 0.38853933156461784, 70, 49, 5.6941366846315, 0.3398369094541219,
      5.6941366846315, 0.3398369094541219, 49, 70,
    ),
  ]
  for row in cases {
    let (
      sample,
      lon,
      lat,
      ring_pixel,
      nested_pixel,
      ring_lon,
      ring_lat,
      nested_lon,
      nested_lat,
      ring2nest,
      nest2ring,
    ) = row
    let point = LonLat::new(lon, lat)
    let actual_ring = grid.lonlat_to_ring(point)
    let actual_nested = grid.lonlat_to_nested(point)
    assert_true(
      actual_ring == ring_pixel,
      msg="ang2pix[\{sample}] RING index: got \{actual_ring}, expected \{ring_pixel}",
    )
    assert_true(
      actual_nested == nested_pixel,
      msg="ang2pix[\{sample}] NESTED index: got \{actual_nested}, expected \{nested_pixel}",
    )
    let ring_distance = grid
      .ring_center(ring_pixel)
      .separation(LonLat::new(ring_lon, ring_lat))
    let nested_distance = grid
      .nested_center(nested_pixel)
      .separation(LonLat::new(nested_lon, nested_lat))
    assert_true(
      ring_distance < 1.0e-10,
      msg="ang2pix[\{sample}] RING center separation: \{ring_distance} radians",
    )
    assert_true(
      nested_distance < 1.0e-10,
      msg="ang2pix[\{sample}] NESTED center separation: \{nested_distance} radians",
    )
    let actual_ring2nest = grid.ring_to_nested(ring_pixel)
    let actual_nest2ring = grid.nested_to_ring(nested_pixel)
    assert_true(
      actual_ring2nest == ring2nest,
      msg="ang2pix[\{sample}] ring2nest: got \{actual_ring2nest}, expected \{ring2nest}",
    )
    assert_true(
      actual_nest2ring == nest2ring,
      msg="ang2pix[\{sample}] nest2ring: got \{actual_nest2ring}, expected \{nest2ring}",
    )
  }
}

