      4.319689898685965, 0.7297276562269663, 9, 9,
    ),
    (
      507, 1.6100054428068324, 0.3513044567080988, 14, 23, 1.5707963267948966, 0.3398369094541219,
      1.5707963267948966, 0.3398369094541219, 23, 14,
    ),
    (
      508, 4.200244417348915, 0.1796212849938442, 25, 30, 4.319689898685965, 0.0,
      4.319689898685965, 0.0, 30, 25,
    ),
    (
      509, 4.191030512393333, 0.12904192431434403, 25, 30, 4.319689898685965, 0.0,
      4.319689898685965, 0.0, 30, 25,
    ),
    (
      510, 4.948386763558544, -0.9687592473429162, 42, 46, 5.105088062083414, -0.7297276562269663,
      5.105088062083414, -0.7297276562269663, 46, 42,
    ),
    (
      511, 2.9826695564407175, 0.11583591279785513, 23, 26, 2.748893571891069, 0.0,
      2.748893571891069, 0.0, 26, 23,
    ),
  ]
  for row in cases {
    let (
      sample,
      lon,
      lat,
      ring_pixel,
      nested_pixel,
      ring_lon,
      ring_lat,
      nested_lon,
      nested_lat,
      ring2nest,
      nest2ring,
    ) = row
    let point = LonLat::new(lon, lat)
    let actual_ring = grid.lonlat_to_ring(point)
    let actual_nested = grid.lonlat_to_nested(point)
    assert_true(
      actual_ring == ring_pixel,
      msg="ang2pix[\{sample}] RING index: got \{actual_ring}, expected \{ring_pixel}",
    )
    assert_true(
      actual_nested == nested_pixel,
      msg="ang2pix[\{sample}] NESTED index: got \{actual_nested}, expected \{nested_pixel}",
    )
    let ring_distance = grid
      .ring_center(ring_pixel)
      .separation(LonLat::new(ring_lon, ring_lat))
    let nested_distance = grid
      .nested_center(nested_pixel)
      .separation(LonLat::new(nested_lon, nested_lat))
    assert_true(
      ring_distance < 1.0e-10,
      msg="ang2pix[\{sample}] RING center separation: \{ring_distance} radians",
    )
    assert_true(
      nested_distance < 1.0e-10,
      msg="ang2pix[\{sample}] NESTED center separation: \{nested_distance} radians",
    )
    let actual_ring2nest = grid.ring_to_nested(ring_pixel)
    let actual_nest2ring = grid.nested_to_ring(nested_pixel)
    assert_true(
      actual_ring2nest == ring2nest,
      msg="ang2pix[\{sample}] ring2nest: got \{actual_ring2nest}, expected \{ring2nest}",
    )
    assert_true(
      actual_nest2ring == nest2ring,
      msg="ang2pix[\{sample}] nest2ring: got \{actual_nest2ring}, expected \{nest2ring}",
    )
  }
}

