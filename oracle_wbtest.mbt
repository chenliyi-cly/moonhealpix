      1146, 6.232725553456201, 0.00010360515945356648, 1567, 1173, 6.234097921967246,
      0.0, 6.234097921967246, 0.0, 1173, 1567,
    ),
    (
      1147, 0.14643146880330804, 0.10013811643373147, 1377, 1134, 0.14726215563702155,
      0.083430086610615, 0.14726215563702155, 0.083430086610615, 1134, 1377,
    ),
    (
      1148, 0.990658771229481, 0.7934426272031257, 429, 108, 0.9948376736367677,
      0.7852913518731984, 0.9948376736367677, 0.7852913518731984, 108, 429,
    ),
    (
      1149, 4.806729369996895, -0.8543385165047757, 2747, 2976, 4.772804223722955,
      -0.894582592023234, 4.772804223722955, -0.894582592023234, 2976, 2747,
    ),
    (
      1150, 5.132715570063219, -1.1631190053627438, 2954, 2854, 5.203262832508095,
      -1.1596584644725492, 5.203262832508095, -1.1596584644725492, 2854, 2954,
    ),
