  interpolation_assert_missing(16, Nested, 0.0, 0.0, 1131)
  interpolation_assert_missing(16, Nested, 0.0, 0.0, 1130)
  interpolation_assert_missing(16, Nested, 0.0, 0.0, 1173)
}
